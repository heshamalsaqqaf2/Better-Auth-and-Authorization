{
  "name": "authentication-better-auth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "depcruise": "depcruise src",
    "depcruise:check": "depcruise src --output-type dot | grep -q error",
    "prepare": "husky",
    "db:drizzleGenerate": "drizzle-kit generate",
    "db:drizzleMigrate": "drizzle-kit migrate",
    "db:drizzleDrop": "drizzle-kit drop",
    "db:drizzleStudio": "drizzle-kit studio",
    "db:test": "tsx --env-file=.env.local src/Scripts/test-db.ts",
    "db:debug": "tsx src/Scripts/debug-env.ts",
    "auth:betterAuthGenerate": "pnpm dlx auth@latest generate --config ./src/core/foundations/infrastructure/services/better-auth/auth-server.ts --output ./src/core/foundations/infrastructure/services/better-auth/generated-betterAuthGenerate.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-store": "^0.11.0",
    "better-auth": "^1.6.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "kysely": "0.28.17",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^16.0.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.0.0",
    "lint-staged": "latest",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "latest"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome check --no-errors-on-unmatched --write"
    ]
  }
}